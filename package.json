{
  "name": "deep-playground-prototype",
  "version": "2016.3.10",
  "description": "",
  "private": true,
  "scripts": {
    "clean": "rimraf dist_ja/analytics.js dist_ja/lib.js dist_ja/bundle.js dist_ja/bundle.css",
    "start": "npm run serve-watch",
    "prep": "copyfiles analytics.js dist_ja && concat node_modules/material-design-lite/material.min.js node_modules/seedrandom/seedrandom.min.js > dist_ja/lib.js",
    "build-css": "concat node_modules/material-design-lite/material.min.css styles.css > dist_ja/bundle.css",
    "watch-css": "concat node_modules/material-design-lite/material.min.css styles.css -o dist_ja/bundle.css",
    "build-js": "browserify src/playground.ts -p [tsify] | uglifyjs -c > dist_ja/bundle.js",
    "watch-js": "watchify src/playground.ts -p [tsify] -v --debug -o dist_ja/bundle.js",
    "build": "npm run prep && npm run build-js && npm run build-css",
    "watch": "npm run prep && concurrently \"npm run watch-js\" \"npm run watch-css\"",
    "serve": "npx serve dist_ja/",
    "serve-watch": "concurrently \"npx serve dist_ja/\" \"npm run watch\"",
    "deploy": "git subtree push --prefix dist_ja origin gh-pages"
  },
  "devDependencies": {
    "@types/d3": "^3.5.34",
    "concat": "^1.0.3",
    "concurrently": "3.1.0",
    "copyfiles": "1.0.0",
    "rimraf": "2.5.4",
    "serve": "^11.3.0",
    "tsify": "^4.0.0",
    "typescript": "^2.9",
    "uglify-js": "^2.8.29",
    "watchify": "^4.0.0"
  },
  "dependencies": {
    "d3": "^3.5.16",
    "material-design-lite": "^1.3.0",
    "seedrandom": "^2.4.3"
  }
}
